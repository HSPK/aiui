# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/coverage-*
/.coverage-*
/e2e/.artifacts
/playwright-report
/test-results

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Loom CLI — compiled artifact from bin/loom.ts via scripts/build-cli.mjs
# (regenerated by `bun install`'s prepare hook and `bun run build`).
/bin/loom.mjs

# Loom runtime data (SQLite, uploads)
/data

# user-provided gateway config (only the example file is committed)
/loom.config.yaml
/loom.config.yml
/loom.config.json
/.config/loom.yaml
/.config/loom.yml
/.config/loom.json

# mkdocs build output (local previews; CI deploys from a fresh build)
/site


