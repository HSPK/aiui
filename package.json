{
  "name": "loom",
  "version": "1.4.8",
  "description": "Self-hosted AI testing platform \u2014 try models and MCP servers, log every request, and front your apps through an OpenAI-compatible gateway.",
  "keywords": [
    "ai",
    "ai-gateway",
    "llm",
    "llm-gateway",
    "llm-proxy",
    "llm-observability",
    "llmops",
    "openai",
    "openai-compatible",
    "mcp",
    "model-context-protocol",
    "playground",
    "self-hosted",
    "sqlite",
    "docker",
    "nextjs"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HSPK/loom.git"
  },
  "homepage": "https://github.com/HSPK/loom#readme",
  "bugs": {
    "url": "https://github.com/HSPK/loom/issues"
  },
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "bin/loom.mjs",
    ".next",
    "drizzle",
    "public",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "loom": "./bin/loom.mjs"
  },
  "scripts": {
    "dev": "next dev",
    "build": "bun run build:cli && LOOM_SKIP_MIGRATIONS=1 next build && bun run build:aliases",
    "build:cli": "node scripts/build-cli.mjs",
    "build:aliases": "node scripts/generate-external-aliases.mjs",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "bench": "vitest bench --run",
    "test:browser": "playwright test --project=e2e",
    "test:experience": "playwright test --project=experience",
    "bench:web": "playwright test --project=perf",
    "bench:web:report": "node scripts/bench-report.mjs",
    "test:e2e": "node scripts/run-e2e.mjs",
    "prepare": "node scripts/build-cli.mjs",
    "prepack": "node scripts/prepack-trim.mjs",
    "prepublishOnly": "bun run build",
    "lint:ci": "node scripts/lint-baseline.mjs"
  },
  "dependencies": {
    "@ai-sdk/react": "^3.0.29",
    "@clack/prompts": "^1.5.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-query": "^5.90.16",
    "@tanstack/react-table": "^8.21.3",
    "@types/react-syntax-highlighter": "^15.5.13",
    "ai": "^6.0.23",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.10.0",
    "citty": "^0.2.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.45.2",
    "katex": "^0.16.27",
    "lucide-react": "^0.562.0",
    "next": "^16.1.6",
    "next-themes": "^0.4.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-json-view": "^1.21.3",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.3.3",
    "react-syntax-highlighter": "^16.1.0",
    "recharts": "^3.6.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "yaml": "^2.9.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/bcryptjs": "^3.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "axe-core": "^4.13.0",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.0",
    "eslint": "^9",
    "eslint-config-next": "16.1.1",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10",
    "vitest-fetch-mock": "^0.4.5"
  },
  "trustedDependencies": [
    "better-sqlite3",
    "esbuild",
    "sharp",
    "unrs-resolver"
  ]
}
