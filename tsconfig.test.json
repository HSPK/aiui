{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["vitest/globals", "node"]
  },
  "include": [
    "next-env.d.ts",
    "tests/**/*.ts",
    "tests/**/*.tsx",
    "bench/**/*.ts",
    "e2e/**/*.ts",
    "playwright.config.ts",
    "vitest.config.mts",
    "lib/**/*.ts",
    "lib/**/*.tsx",
    "components/**/*.tsx",
    "components/**/*.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "context/**/*.tsx"
  ],
  "exclude": ["node_modules"]
}
